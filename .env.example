# 9Router config template — copy to `.env` and adjust values.

# Server port & bind host
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production

# First-login password for the dashboard (only used until you change it)
INITIAL_PASSWORD=change-me

# JWT signing secret for the dashboard auth cookie (generate with: openssl rand -hex 32)
JWT_SECRET=

# HMAC secrets used for generated /v1 API keys + stable machine-id hashing
API_KEY_SECRET=
MACHINE_ID_SALT=

# Base URLs (used by cloud-sync callbacks / links)
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Security on an internet-exposed deployment
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=true

# Request/response logs under logs/
ENABLE_REQUEST_LOGS=true

# Tailscale full automation (scripts/tailscale-setup.sh + tailscale-autoconfigure.mjs).
# Provide EITHER an API access token OR an OAuth client (id + secret).
# The API credentials need permissions for: tailnet settings (HTTPS), DNS prefs,
# ACL update, and auth key creation (or use an OAuth client with the auth_keys scope).
# TAILSCALE_API_KEY=tskey-api-xxxxxxxxxxxxxxxxxxx
# TAILSCALE_CLIENT_ID=
# TAILSCALE_CLIENT_SECRET=
# TAILSCALE_TAILNET=
# TAILSCALE_TAGS=tag:server
# TAILSCALE_HOSTNAME=9router
